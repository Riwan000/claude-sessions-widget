QWidget#root {
    background-color: rgba(6, 26, 20, 248);
    border: 1px solid rgba(0, 168, 107, 180);
    border-radius: 14px;
}

QFrame#header {
    background: transparent;
}

QLabel#titleLabel {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#countLabel {
    color: #5eead4;
    font-size: 11px;
    padding-left: 4px;
    font-weight: 600;
}

QPushButton#hideButton {
    background: transparent;
    color: #5eead4;
    border: none;
    font-size: 13px;
    padding: 2px 8px;
    border-radius: 6px;
}
QPushButton#hideButton:hover {
    background-color: rgba(0, 168, 107, 40);
    color: #ffffff;
}

QPushButton#collapseButton {
    background: transparent;
    color: #5eead4;
    border: none;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 6px;
}
QPushButton#collapseButton:hover {
    background-color: rgba(0, 168, 107, 40);
    color: #ffffff;
}

QFrame#sessionRow {
    background-color: rgba(13, 46, 35, 160);
    border: 1px solid rgba(0, 168, 107, 60);
    border-radius: 10px;
}
QFrame#sessionRow:hover {
    background-color: rgba(13, 46, 35, 230);
    border: 1px solid rgba(0, 168, 107, 140);
}
QFrame#sessionRow[status="permission"] {
    background-color: rgba(22, 65, 50, 220);
    border: 1px solid rgba(239, 68, 68, 180);
}
QFrame#sessionRow[status="permission"]:hover {
    background-color: rgba(22, 65, 50, 250);
    border: 1px solid rgba(239, 68, 68, 220);
}

QFrame#accentBar {
    border-radius: 2px;
}
QFrame#accentBar[status="running"] { background-color: #00a86b; }
QFrame#accentBar[status="idle"] { background-color: #38bdf8; }
QFrame#accentBar[status="finished"] { background-color: #00a86b; }
QFrame#accentBar[status="stale"] { background-color: #f59e0b; }
QFrame#accentBar[status="permission"][blink="on"] { background-color: #ef4444; }
QFrame#accentBar[status="permission"][blink="off"] { background-color: #7f1d1d; }

QLabel#statusDot {
    border-radius: 4px;
}
QLabel#statusDot[status="running"] { background-color: #00a86b; }
QLabel#statusDot[status="idle"] { background-color: #38bdf8; }
QLabel#statusDot[status="finished"] { background-color: #00a86b; }
QLabel#statusDot[status="stale"] { background-color: #f59e0b; }
QLabel#statusDot[status="permission"][blink="on"] { background-color: #ef4444; }
QLabel#statusDot[status="permission"][blink="off"] { background-color: #7f1d1d; }

QLabel#projectLabel {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#personalityLabel {
    color: #5eead4;
    font-size: 11px;
    font-weight: 600;
    padding-left: 4px;
}

QLabel#taskLabel {
    color: #a7f3d0;
    font-size: 11px;
}

QLabel#timeLabel {
    color: #5eead4;
    font-size: 10px;
}

QLabel#tokenLabel,
QLabel#contextLabel,
QLabel#modelLabel {
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    background-color: rgba(0, 168, 107, 50);
    border: 1px solid rgba(0, 168, 107, 80);
    border-radius: 7px;
    padding: 2px 7px;
}
QLabel#tokenLabel[tokenTier="warn"],
QLabel#contextLabel[tokenTier="warn"] {
    color: #fde047;
    background-color: rgba(250, 204, 21, 40);
    border: 1px solid rgba(250, 204, 21, 90);
}
QLabel#tokenLabel[tokenTier="high"],
QLabel#contextLabel[tokenTier="high"] {
    color: #fdba74;
    background-color: rgba(249, 115, 22, 40);
    border: 1px solid rgba(249, 115, 22, 90);
}
QLabel#tokenLabel[tokenTier="critical"],
QLabel#contextLabel[tokenTier="critical"] {
    color: #fca5a5;
    background-color: rgba(239, 68, 68, 50);
    border: 1px solid rgba(239, 68, 68, 100);
}

QLabel#emptyLabel {
    color: #5eead4;
    font-size: 12px;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget {
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(0, 168, 107, 80);
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QSizeGrip {
    background: transparent;
    width: 12px;
    height: 12px;
}
